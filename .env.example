# ─── Database ─────────────────────────────────
POSTGRES_USER=poltica_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=poltica

# Set DATABASE_URL to run the store on PostgreSQL. If unset, the API uses a
# local JSON file store (dev only). Existing .data/*.json is auto-imported once.
#   DATABASE_URL=postgresql://poltica_admin:PASSWORD@localhost:5432/poltica
# DATABASE_URL=

# ─── API Server ───────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Payment Gateway ─────────────────────────
# Must match the webhook secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_TO_A_SECURE_SECRET

# ─── Secrets ─────────────────────────────────
# Generate strong, unique values, e.g.:
#   JWT_SECRET:                 openssl rand -hex 48
#   CREDENTIALS_ENCRYPTION_KEY: openssl rand -hex 16   (32-char AES-256 key)
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY
